# Copy to .env and set credentials to auto-create the PM2 WebUI admin user
# on first container start. Leave unset to run `npm run setup-admin-user`
# manually instead. These are only applied once (when no admin exists yet).
#
# Password rules enforced by the WebUI login form (pick a value that matches,
# otherwise you can log in but the UI considers it weak): min 8 chars, with at
# least one lowercase, one uppercase, one digit and one symbol (!@#$%^&*).
# Username: lowercase letters, digits and underscore, min 4 chars.
PM2_WEBUI_USERNAME=admin
PM2_WEBUI_PASSWORD=ChangeMe1!
